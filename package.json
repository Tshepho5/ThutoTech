{
  "name": "thutotech-root",
  "version": "1.0.0",
  "private": true,
  "description": "ThutoTech Digital School Ecosystem",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "build": "npm --prefix backend install && npm --prefix backend run prisma:generate && npm --prefix backend run build",
    "start": "npm --prefix backend run start",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start",
    "backend:migrate": "npm --prefix backend run prisma:migrate",
    "backend:studio": "npm --prefix backend run prisma:studio",
    "app": "flutter run -d chrome",
    "app:chrome": "flutter run -d chrome",
    "app:windows": "flutter run -d windows",
    "app:test": "flutter test",
    "test": "flutter test"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
