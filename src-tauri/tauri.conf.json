{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "https://thutotech-2-0.onrender.com",
    "distDir": "../backend/public"
  },
  "package": {
    "productName": "ThutoTech",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": false,
        "open": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://thutotech-2-0.onrender.com/*", "http://localhost:*/*"]
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "© 2026 ThutoTech Academy. All rights reserved.",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.thutotech.desktop",
      "longDescription": "ThutoTech Digital School Ecosystem • LEARN • CONNECT • EMPOWER",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "ThutoTech Educational Ecosystem",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "ThutoTech 2.0 • LEARN • CONNECT • EMPOWER",
        "width": 1280,
        "minHeight": 600,
        "minWidth": 960,
        "center": true
      }
    ]
  }
}
