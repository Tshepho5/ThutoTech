datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  LEARNER
  PARENT
  TEACHER
  PRINCIPAL
  ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  MARKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NotificationCategory {
  ACADEMIC
  ATTENDANCE
  ANNOUNCEMENT
  ACHIEVEMENT
  SYSTEM
}

enum AnnouncementPriority {
  NORMAL
  HIGH
  URGENT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model School {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  contactEmail String
  address      String?
  activeYear   Int           @default(2026)
  currentTerm  Int           @default(1)
  users        User[]
  classes      SchoolClass[]
  subjects     Subject[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("schools")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  surname      String
  role         UserRole
  phone        String?
  avatarUrl    String?
  status       UserStatus        @default(ACTIVE)
  schoolId     String?
  school       School?           @relation(fields: [schoolId], references: [id])
  learner      Learner?
  parent       Parent?
  teacher      Teacher?
  notifications AppNotification[]
  auditLogs    AuditLog[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model Parent {
  id                         String                      @id @default(uuid())
  userId                     String                      @unique
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                   String
  surname                    String
  phone                      String
  email                      String
  hasSecondaryParent         Boolean                     @default(false)
  secondaryParentFullName    String?
  secondaryParentSurname     String?
  secondaryParentPhone       String?
  secondaryParentEmail       String?
  relationships              ParentLearnerRelationship[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@map("parents")
}

model Learner {
  id                      String                      @id @default(uuid())
  userId                  String                      @unique
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerNumber           String?                     @unique // e.g. 20260001
  idNumber                String                      @unique // 13-digit National ID
  fullName                String
  surname                 String
  gender                  String?
  dateOfBirth             DateTime?
  age                     Int?
  grade                   String                      // e.g. "Grade 10"
  className               String                      // e.g. "Grade 10A"
  homeLanguage            String?                     @default("English")
  firstAdditionalLanguage String?                     @default("Afrikaans")
  stream                  String?                     // Science, Commerce, Tourism
  schoolId                String
  attendancePercentage    Float                       @default(100.0)
  overallAverage          Float                       @default(0.0)
  parents                 ParentLearnerRelationship[]
  enrolments           ClassEnrolment[]
  submissions          Submission[]
  attendanceRecords    AttendanceRecord[]
  achievements         Achievement[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([idNumber])
  @@index([grade])
  @@map("learners")
}

model ParentLearnerRelationship {
  id         String   @id @default(uuid())
  parentId   String
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  learnerId  String
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  @@unique([parentId, learnerId])
  @@map("parent_learner_relationships")
}

model Teacher {
  id          String                   @id @default(uuid())
  userId      String                   @unique
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  surname     String
  schoolId    String
  classes     SchoolClass[]
  assignments Assignment[]
  teaching    TeacherClassAssignment[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@map("teachers")
}

model SchoolClass {
  id         String                   @id @default(uuid())
  name       String                   // e.g. "Grade 10A"
  grade      String                   // e.g. "Grade 10"
  teacherId  String?
  teacher    Teacher?                 @relation(fields: [teacherId], references: [id])
  schoolId   String
  school     School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrolments ClassEnrolment[]
  assignments Assignment[]
  attendance  AttendanceRecord[]
  teaching   TeacherClassAssignment[]
  createdAt  DateTime                 @default(now())

  @@map("school_classes")
}

model Subject {
  id        String                   @id @default(uuid())
  name      String                   // e.g. "Mathematics"
  code      String                   // e.g. "MATH10"
  grade     String                   // e.g. "Grade 10"
  schoolId  String
  school    School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  teaching   TeacherClassAssignment[]
  createdAt DateTime                 @default(now())

  @@map("subjects")
}

model ClassEnrolment {
  id        String      @id @default(uuid())
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  year      Int         @default(2026)
  createdAt DateTime    @default(now())

  @@unique([classId, learnerId, year])
  @@map("class_enrolments")
}

model TeacherClassAssignment {
  id        String      @id @default(uuid())
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([teacherId, classId, subjectId])
  @@map("teacher_class_assignments")
}

model Assignment {
  id          String           @id @default(uuid())
  title       String
  description String
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId     String
  class       SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  maxMarks    Float            @default(100.0)
  status      AssignmentStatus @default(PUBLISHED)
  submissions Submission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([classId])
  @@index([dueDate])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learnerId    String
  learner      Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  submittedAt  DateTime?
  status       SubmissionStatus @default(NOT_SUBMITTED)
  mark         Float?
  feedback     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, learnerId])
  @@map("submissions")
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  date      DateTime         @default(now())
  classId   String
  class     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  reason    String?
  createdAt DateTime         @default(now())

  @@index([date])
  @@index([learnerId])
  @@map("attendance_records")
}

model Achievement {
  id          String   @id @default(uuid())
  learnerId   String
  learner     Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  title       String
  description String
  iconName    String
  category    String   // ACADEMIC, ATTENDANCE, LEADERSHIP
  awardedAt   DateTime @default(now())

  @@map("achievements")
}

model AppNotification {
  id              String               @id @default(uuid())
  recipientUserId String
  user            User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  title           String
  body            String
  isRead          Boolean              @default(false)
  category        NotificationCategory
  actionLink      String?
  createdAt       DateTime             @default(now())

  @@index([recipientUserId])
  @@map("notifications")
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  content     String
  authorId    String
  authorName  String
  audience    String               // ALL, PARENTS, LEARNERS, TEACHERS, GRADE_10, etc.
  priority    AnnouncementPriority @default(NORMAL)
  publishedAt DateTime             @default(now())

  @@map("announcements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  role      String
  action    String
  entity    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model AdmissionApplication {
  id                         String               @id @default(uuid())
  applicationNumber          String               @unique
  // Primary Parent
  primaryParentName          String
  primaryParentSurname       String
  primaryParentPhone         String
  primaryParentEmail         String
  primaryParentIdNumber      String
  primaryParentGender        String?
  primaryParentDob           DateTime?
  primaryParentDocumentUrl   String?
  // Optional Secondary Parent
  hasSecondaryParent         Boolean              @default(false)
  secondaryParentName        String?
  secondaryParentSurname     String?
  secondaryParentPhone       String?
  secondaryParentEmail       String?
  secondaryParentIdNumber    String?
  secondaryParentGender      String?
  secondaryParentDob         DateTime?
  secondaryParentDocumentUrl String?
  // Multi-Learner Relationship
  learners                   ApplicationLearner[]
  // Legacy / Single Learner Compatibility fields
  learnerName                String?
  learnerSurname             String?
  learnerIdNumber            String?
  learnerGender              String?
  learnerDob                 DateTime?
  learnerAge                 Int?
  gradeApplyingFor           String?
  homeLanguage               String?              @default("English")
  firstAdditionalLanguage    String?              @default("Afrikaans")
  stream                     String?
  previousSchool             String?
  documentVerified           Boolean              @default(false)
  // Workflow Status
  status                     ApplicationStatus    @default(SUBMITTED)
  registrationToken          String               @unique
  reviewerNotes              String?
  reviewedAt                 DateTime?
  submittedAt                DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([applicationNumber])
  @@index([registrationToken])
  @@map("admission_applications")
}

model ApplicationLearner {
  id                      String               @id @default(uuid())
  applicationId           String
  application             AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  learnerName             String
  learnerSurname          String
  learnerIdNumber         String               // 13 digits
  learnerGender           String?
  learnerDob              DateTime?
  learnerAge              Int?
  gradeApplyingFor        String
  homeLanguage            String               @default("English")
  firstAdditionalLanguage String?              @default("Afrikaans")
  stream                  String?              // Science, Commerce, Tourism (Gr 10-12)
  previousSchool          String
  documentUrl             String?
  documentName            String?
  documentVerified        Boolean              @default(false)
  createdAt               DateTime             @default(now())

  @@index([applicationId])
  @@index([learnerIdNumber])
  @@map("application_learners")
}

model AutomationRule {
  id                   String   @id @default(uuid())
  name                 String
  eventName            String
  conditionDescription String
  actionDescription    String
  isActive             Boolean  @default(true)
  lastRun              DateTime @default(now())
  runCount             Int      @default(0)
  createdAt            DateTime @default(now())

  @@map("automation_rules")
}
